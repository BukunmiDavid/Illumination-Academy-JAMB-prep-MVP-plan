# Local dev: leave unset. vite.config.ts proxies /api to http://127.0.0.1:8000.
#
# Production (Vercel): set this to your deployed API, e.g.
#   VITE_API_URL=https://illumination-academy-api.onrender.com
# Vite reads .env only at build time, so set it in the Vercel project env vars
# or reference a .env.production file. Do NOT commit real keys.
VITE_API_URL=

# Your bot's WhatsApp number in international form WITHOUT the '+' (e.g. 2348012345678).
# Enables the "Study on WhatsApp" card (wa.me link + QR) on the home screen.
VITE_WHATSAPP_NUMBER=

# Optional Telegram channel/bot share link, e.g. https://t.me/IlluminationAcademyBot
# Adds a "Telegram" button on the home screen next to WhatsApp.
VITE_TELEGRAM_LINK=