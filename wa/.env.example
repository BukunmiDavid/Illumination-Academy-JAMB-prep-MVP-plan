# Where the Illumination Academy API lives
API_URL=http://127.0.0.1:8000

# Where Baileys stores your authenticated session (scan the QR once)
AUTH_DIR=./auth

# Comma-separated allowed phone numbers in international form (e.g. 2348012345678).
# Leave empty to allow any number during the pilot. Only the pilot WhatsApp number
# should be listed in production.
ALLOWED_NUMBERS=